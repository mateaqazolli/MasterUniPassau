# Synthetic Market Basket, N = 10,000 (seeded generation, seed 42)
# Thesis: Section 6.9 (second part), Tables 6.15-6.18.
EXPERIMENT=market_basket_10000

# Dataset generation (seeded sampling from 5 base transactions, Table A.1)
GEN_SIZE=10000
TXT_NAME=MarketBasket10000
SOLVER_TXT=qa-datasets/MarketBasket10000.txt
CSV_NAME=DataMining_MarketBasket_10000

# PostgreSQL objects used by the query workload
DB_NAME=market_basket
TABLE_NAME=transactions
NUM_VARS=6

# Cardinality-estimation scripts (bnsl-qa = AnnealBN-CE, bnsl = Chow-Liu)
CE_SCRIPT_QA=cardinality_estimation/cardinality_estimation_Market_Basket.py
CE_SCRIPT_CL=cardinality_estimation/cardinality_estimation_market_basket.py

# Table 6.2 grid: read sweep at fixed trials, trial sweep at fixed reads
READ_SWEEP_TRIALS=20
READ_SWEEP="100 500 1000 5000 10000"
TRIAL_SWEEP_READS=1000
TRIAL_SWEEP="1 5 10 20 50"

# Configuration behind the headline estimates in Table 6.15 (stable pattern
# across essentially all configurations)
HEADLINE_TRIALS=20
HEADLINE_READS=1000
