# WetGrass, N = 100 (expected-value generation, variance zero)
# Thesis: Section 6.7, Tables 6.3-6.4; run grid from Table 6.2.
EXPERIMENT=wetgrass_100

# Dataset generation (bnslqa generate --expected)
GEN_PROBLEM=problems/WetGrass.json
GEN_SIZE=100
TXT_NAME=WetGrass
SOLVER_TXT=qa-datasets/WetGrass.txt
CSV_NAME=WetGrass_variance_zero

# PostgreSQL objects used by the query workload
DB_NAME=wetgrass
TABLE_NAME=wetgrass_data
NUM_VARS=4

# Cardinality-estimation scripts (bnsl-qa = AnnealBN-CE, bnsl = Chow-Liu)
CE_SCRIPT_QA=cardinality_estimation/cardinality_estimation_WetGrass.py
CE_SCRIPT_CL=cardinality_estimation/cardinality_estimation_wetgrass.py

# Table 6.2 grid: read sweep at fixed trials, trial sweep at fixed reads
READ_SWEEP_TRIALS=30
READ_SWEEP="10 50 100 250 500"
TRIAL_SWEEP_READS=100
TRIAL_SWEEP="5 10 20 50"

# Configuration behind the headline estimates in Table 6.3 (stable vector:
# SA from R=50, SQA from R=100 in the T=30 read sweep)
HEADLINE_TRIALS=30
HEADLINE_READS=100
