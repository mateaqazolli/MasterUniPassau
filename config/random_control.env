# Random-structure robustness check on Market Basket N = 100
# Thesis: Section 6.9, Table 6.14 — 1000 admissible random DAGs (max 2
# parents, acyclic; 960 unique after deduplication) evaluated with the same
# cardinality-estimation script and workload as the annealing runs.
EXPERIMENT=random_control

# Base dataset the random structures are evaluated on
BASE_CONFIG=config/market_basket_100.env

NUM_VARS=6
NUM_MATRICES=1000

# QUICK mode uses a reduced matrix count for the smoke test
QUICK_NUM_MATRICES=20
