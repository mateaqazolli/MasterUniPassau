# WetGrass, N = 10,000 (expected-value generation, variance zero)
# Thesis: Section 6.7, Tables 6.5-6.6; run grid from Table 6.2.
EXPERIMENT=wetgrass_10000

# Dataset generation (bnslqa generate --expected)
GEN_PROBLEM=problems/WetGrass.json
GEN_SIZE=10000
TXT_NAME=WetGrass_10000
SOLVER_TXT=qa-datasets/WetGrass_10000.txt
CSV_NAME=WetGrass_10000

# PostgreSQL objects used by the query workload
DB_NAME=wetgrass
TABLE_NAME=wetgrass_data
NUM_VARS=4

# Cardinality-estimation scripts (bnsl-qa = AnnealBN-CE, bnsl = Chow-Liu)
CE_SCRIPT_QA=cardinality_estimation/cardinality_estimation_WetGrass.py
CE_SCRIPT_CL=cardinality_estimation/cardinality_estimation_wetgrass.py

# Table 6.2 grid: read sweep at fixed trials, trial sweep at fixed reads
READ_SWEEP_TRIALS=20
READ_SWEEP="100 500 1000 5000 10000"
TRIAL_SWEEP_READS=1000
TRIAL_SWEEP="1 5 10 20 50"

# Configuration behind the headline estimates in Table 6.5 (the exact
# vector is obtained across all evaluated configurations)
HEADLINE_TRIALS=20
HEADLINE_READS=1000
