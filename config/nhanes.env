# NHANES age-prediction subset, N = 2,278 (real data, fixed size)
# Thesis: Section 6.8, Tables 6.7-6.9; run grid from Table 6.2.
EXPERIMENT=nhanes

# Solver TXT is produced by Nhanes_csv_to_txt.py from the committed CSV
GEN_SIZE=2278
TXT_NAME=NHANES_Medical_4vars
SOLVER_TXT=qa-datasets/NHANES_Medical_4vars.txt
CSV_NAME=NHANES_age_prediction

# PostgreSQL objects used by the query workload
DB_NAME=nhanes
TABLE_NAME=nhanes_data
NUM_VARS=4

# Cardinality-estimation scripts (bnsl-qa = AnnealBN-CE, bnsl = Chow-Liu)
CE_SCRIPT_QA=cardinality_estimation/cardinality_estimation_NHANES.py
CE_SCRIPT_CL=cardinality_estimation/cardinality_estimation_NHANES_robust.py

# Table 6.2 grid: read sweep at fixed trials, trial sweep at fixed reads
READ_SWEEP_TRIALS=10
READ_SWEEP="100 500 1000 2500"
TRIAL_SWEEP_READS=1000
TRIAL_SWEEP="5 10 20"

# Configuration behind the headline estimates in Table 6.8 (lowest tested
# budget, representative because all configurations agreed)
HEADLINE_TRIALS=10
HEADLINE_READS=100
