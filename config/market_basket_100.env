# Synthetic Market Basket, N = 100 (seeded generation, seed 42)
# Thesis: Section 6.9 (first part), Tables 6.10-6.13 and Figure 6.1.
EXPERIMENT=market_basket_100

# Dataset generation (seeded sampling from 5 base transactions, Table A.1)
GEN_SIZE=100
TXT_NAME=MarketBasket100
SOLVER_TXT=qa-datasets/MarketBasket100.txt
CSV_NAME=DataMining_MarketBasket_100

# PostgreSQL objects used by the query workload
DB_NAME=market_basket
TABLE_NAME=transactions
NUM_VARS=6

# Cardinality-estimation scripts (bnsl-qa = AnnealBN-CE, bnsl = Chow-Liu)
CE_SCRIPT_QA=cardinality_estimation/cardinality_estimation_Market_Basket.py
CE_SCRIPT_CL=cardinality_estimation/cardinality_estimation_market_basket.py

# Table 6.2 grid: read sweep at fixed trials, trial sweep at fixed reads
READ_SWEEP_TRIALS=30
READ_SWEEP="10 50 100 250 500"
TRIAL_SWEEP_READS=100
TRIAL_SWEEP="5 10 20 50"

# Configuration behind the headline estimates in Table 6.10 (stable pattern:
# SA from R=250, SQA from R=100 in the T=30 read sweep); also the annealing
# side of the Table 6.14 random-structure comparison
HEADLINE_TRIALS=30
HEADLINE_READS=250
